# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=churnops
POSTGRES_USER=churnops
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# API
# MODEL_URI=models:/churnops-model@champion        # serve from MLflow registry
# MODEL_URI=artifacts/champion_model               # serve the exported champion (default in Docker)
# MLFLOW_TRACKING_URI=http://localhost:5000
# DATABASE_URL=postgresql+psycopg2://churnops:change-me@localhost:5432/churnops
# LOG_PREDICTIONS=true
# MAX_BATCH_SIZE=1000

# Security: comma-separated API keys for the X-API-Key header (empty = no auth, local dev only).
# Two keys at once allow rotation without downtime. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=
# RATE_LIMIT_PER_MINUTE=600      # per client on scoring endpoints; 0 disables
# CHURNOPS_API_KEY=              # key used by `make simulate-traffic` when API_KEYS is set

# Config file for training / monitoring hyperparameters (default configs/config.yaml)
# CHURNOPS_CONFIG=configs/config.yaml
